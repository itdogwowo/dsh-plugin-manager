{
  "name": "dsh-plugin-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件管理器：裝之前驗、裝之前影、裝之後再驗、失敗自動回滾。",
  "type": "module",
  "license": "MIT",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "verify": "node build-client.mjs --check && node verify.mjs",
    "test": "node build-client.mjs --check && node verify.mjs && node --test --test-isolation=none \"test/*.test.mjs\"",
    "test:isolated": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {}
}
